# ZapPDF Environment Variables
# Copy this file to .env and fill in your values

# 1. Groq API Key (Recommended - Ultra-fast LPU inference, 100% Free)
# Get your free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Alternative: Google Gemini API Key
# Get your free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
